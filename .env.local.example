# --- Private / Secret Settings ---
# Copy this file to .env.local and fill in the actual values.
# DO NOT commit .env.local to source control.

# GitHub
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_xxxxxxxxxxxx

# Supabase Keys
# The "anon" key is for client-side use, but we treat it as a key to be configured.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend Internal Keys
# SUPABASE_KEY is typically the same as the anon key for normal operations.
SUPABASE_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY must NEVER be exposed to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Docker specific (Optional override)
SUPABASE_URL=http://host.docker.internal:54321
